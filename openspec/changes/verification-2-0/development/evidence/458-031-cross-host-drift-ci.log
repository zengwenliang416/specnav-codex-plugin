          status: 'blocked',
          observation: null,
          prompt: null,
          model: null,
          screenshots: [],
          artifacts: [],
          assertions: [],
          blockers: [executionBlocker(
            'verification-execution:midscene-adapter-result-invalid',
            'midscene-adapter'
