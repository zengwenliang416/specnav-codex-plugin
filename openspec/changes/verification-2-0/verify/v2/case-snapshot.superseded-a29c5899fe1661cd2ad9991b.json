          "action": "Run regression scope and repeat a no-progress failure cycle.",
          "expected": "Required regressions control closure and repeated no-progress routes to break-loop governance.",
          "assertion_ids": [
            "CASE-04-A03"
          ]
        }
      ],
      "assertions": [
