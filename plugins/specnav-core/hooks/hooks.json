{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/specnav-session-start.js\"",
            "statusMessage": "Loading SpecNav context"
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/cross-repo-announce.js\"",
            "timeout": 10,
            "statusMessage": "Scanning sibling CodeGraph indexes"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/specnav-user-prompt-submit.js\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/specnav-guard.js\"",
            "timeout": 15,
            "statusMessage": "Checking SpecNav gates"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/cross-repo-guard.js\"",
            "timeout": 10,
            "statusMessage": "Checking cross-repo search redirect"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/specnav-post-tool.js\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
