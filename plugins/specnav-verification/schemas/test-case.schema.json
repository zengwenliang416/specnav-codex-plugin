{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specnav.dev/schemas/verification/v2/test-case.schema.json",
  "title": "SpecNav Verification 2.0 Test Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "change_id",
    "requirement_ids",
    "acceptance_ids",
    "title",
    "goal",
    "actor",
    "priority",
    "preconditions",
    "steps",
    "assertions",
    "domains",
    "runner",
    "evidence_policy",
    "status",
    "created_at"
  ],
  "properties": {
    "schema": {
      "const": "specnav.verification.test-case.v1"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "change_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/stableId"
      },
      "uniqueItems": true
    },
    "acceptance_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/stableId"
      },
      "uniqueItems": true
    },
    "title": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "goal": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "actor": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "priority": {
      "$ref": "common.schema.json#/$defs/priority"
    },
    "preconditions": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "action",
          "expected",
          "assertion_ids"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/stableId"
          },
          "action": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          },
          "expected": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          },
          "assertion_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "common.schema.json#/$defs/stableId"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "expected",
          "oracle",
          "evidence_kinds"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/stableId"
          },
          "statement": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          },
          "expected": {},
          "oracle": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "human_signoff_allowed"
            ],
            "properties": {
              "type": {
                "enum": [
                  "playwright_assertion",
                  "api_fact",
                  "database_fact",
                  "structured_comparison",
                  "human_signoff"
                ]
              },
              "human_signoff_allowed": {
                "type": "boolean"
              }
            }
          },
          "evidence_kinds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "common.schema.json#/$defs/evidenceKind"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "domains": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "facticity",
        "static",
        "unit",
        "redteam",
        "e2e",
        "sensory"
      ],
      "properties": {
        "facticity": {
          "$ref": "common.schema.json#/$defs/domainAssignment"
        },
        "static": {
          "$ref": "common.schema.json#/$defs/domainAssignment"
        },
        "unit": {
          "$ref": "common.schema.json#/$defs/domainAssignment"
        },
        "redteam": {
          "$ref": "common.schema.json#/$defs/domainAssignment"
        },
        "e2e": {
          "$ref": "common.schema.json#/$defs/domainAssignment"
        },
        "sensory": {
          "$ref": "common.schema.json#/$defs/domainAssignment"
        }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "timeout_ms",
        "requires_midscene"
      ],
      "properties": {
        "kind": {
          "$ref": "common.schema.json#/$defs/runnerKind"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "entrypoint": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "env_keys": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        },
        "browser_project": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "scenario_id": {
          "$ref": "common.schema.json#/$defs/stableId"
        },
        "scenario_hash": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "prompt_id": {
          "$ref": "common.schema.json#/$defs/stableId"
        },
        "prompt_hash": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "start_url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "oracle_scenario_hash": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "oracle_assertion_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/stableId"
          },
          "uniqueItems": true
        },
        "allowed_origins": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^https?://[^/?#]+$"
          },
          "uniqueItems": true
        },
        "requires_midscene": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "command"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "entrypoint",
              "args",
              "cwd",
              "env_keys"
            ],
            "properties": {
              "entrypoint": {
                "$ref": "common.schema.json#/$defs/nonEmptyString"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "cwd": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
              },
              "env_keys": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/nonEmptyString"
                },
                "uniqueItems": true
              },
              "requires_midscene": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "playwright"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "scenario_id",
              "scenario_hash",
              "browser_project",
              "allowed_origins"
            ],
            "properties": {
              "scenario_id": {
                "$ref": "common.schema.json#/$defs/stableId"
              },
              "scenario_hash": {
                "$ref": "common.schema.json#/$defs/sha256"
              },
              "browser_project": {
                "$ref": "common.schema.json#/$defs/nonEmptyString"
              },
              "allowed_origins": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^https?://[^/?#]+$"
                },
                "uniqueItems": true
              },
              "requires_midscene": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "midscene"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "scenario_id",
              "scenario_hash",
              "browser_project",
              "allowed_origins",
              "prompt_id",
              "prompt_hash",
              "start_url",
              "oracle_scenario_hash",
              "oracle_assertion_ids"
            ],
            "properties": {
              "scenario_id": {
                "$ref": "common.schema.json#/$defs/stableId"
              },
              "scenario_hash": {
                "$ref": "common.schema.json#/$defs/sha256"
              },
              "browser_project": {
                "$ref": "common.schema.json#/$defs/nonEmptyString"
              },
              "allowed_origins": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^https?://[^/?#]+$"
                },
                "uniqueItems": true
              },
              "prompt_id": {
                "$ref": "common.schema.json#/$defs/stableId"
              },
              "prompt_hash": {
                "$ref": "common.schema.json#/$defs/sha256"
              },
              "start_url": {
                "type": "string",
                "pattern": "^https?://"
              },
              "oracle_scenario_hash": {
                "$ref": "common.schema.json#/$defs/sha256"
              },
              "oracle_assertion_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "common.schema.json#/$defs/stableId"
                },
                "uniqueItems": true
              },
              "requires_midscene": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "evidence_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_kinds",
        "required_kinds",
        "retain_on_failure",
        "content_addressed"
      ],
      "properties": {
        "allowed_kinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/evidenceKind"
          },
          "uniqueItems": true
        },
        "required_kinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/evidenceKind"
          },
          "uniqueItems": true
        },
        "retain_on_failure": {
          "const": true
        },
        "content_addressed": {
          "const": true
        }
      }
    },
    "status": {
      "enum": [
        "draft",
        "ready",
        "retired"
      ]
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/dateTime"
    }
  }
}
