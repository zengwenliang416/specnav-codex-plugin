{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specnav.dev/schemas/verification/v2/failure-packet.schema.json",
  "title": "SpecNav Verification 2.0 Failure Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "change_id",
    "run_id",
    "case_id",
    "attempt_id",
    "reading_ids",
    "evidence_ids",
    "classification",
    "status",
    "next_action",
    "summary",
    "root_cause",
    "failed_assertion_ids",
    "owner",
    "created_at",
    "frozen_at"
  ],
  "properties": {
    "schema": {
      "const": "specnav.verification.failure-packet.v1"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "change_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "case_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "attempt_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "reading_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/stableId"
      },
      "uniqueItems": true
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/stableId"
      },
      "uniqueItems": true
    },
    "classification": {
      "enum": [
        null,
        "product_defect",
        "test_defect",
        "environment_defect",
        "flaky",
        "expected_blocker",
        "requirement_ambiguity"
      ]
    },
    "status": {
      "enum": [
        "open",
        "classified",
        "repair_required",
        "retry_allowed",
        "blocked_for_decision",
        "fixed",
        "verified",
        "closed",
        "reopened",
        "break_loop"
      ]
    },
    "next_action": {
      "enum": [
        "repair_required",
        "retry_allowed",
        "blocked_for_decision",
        "break_loop"
      ]
    },
    "summary": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "root_cause": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "failed_assertion_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/stableId"
      },
      "uniqueItems": true
    },
    "owner": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/dateTime"
    },
    "frozen_at": {
      "$ref": "common.schema.json#/$defs/dateTime"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "classification": {
            "type": "null"
          }
        },
        "required": [
          "classification"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "open"
          },
          "next_action": {
            "const": "blocked_for_decision"
          },
          "owner": {
            "const": "verification"
          }
        }
      }
    }
  ]
}
