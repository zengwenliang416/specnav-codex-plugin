{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specnav.dev/schemas/verification/v2/case-snapshot.schema.json",
  "title": "SpecNav Verification 2.0 Case Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "change_id",
    "snapshot_hash",
    "cases",
    "created_at",
    "created_by",
    "requirements_hash",
    "acceptance_hash"
  ],
  "properties": {
    "schema": {
      "const": "specnav.verification.case-snapshot.v1"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "change_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "snapshot_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "test-case.schema.json"
      }
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/dateTime"
    },
    "created_by": {
      "$ref": "common.schema.json#/$defs/reviewer"
    },
    "requirements_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "acceptance_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    }
  }
}
