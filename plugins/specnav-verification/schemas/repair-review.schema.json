{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specnav.dev/schemas/verification/v2/repair-review.schema.json",
  "title": "SpecNav Verification 2.0 Repair Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "kind",
    "verdict",
    "reviewer_id",
    "reviewer_kind",
    "reviewed_at",
    "evidence_id",
    "task_id",
    "failure_id",
    "repair_link_id",
    "repair_link_digest",
    "scope_digest",
    "after_identity_digest"
  ],
  "properties": {
    "schema": {
      "const": "specnav.verification.repair-review.v1"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "kind": {
      "enum": [
        "spec-review",
        "quality-review"
      ]
    },
    "verdict": {
      "const": "approved"
    },
    "reviewer_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "reviewer_kind": {
      "const": "human"
    },
    "reviewed_at": {
      "$ref": "common.schema.json#/$defs/dateTime"
    },
    "evidence_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "task_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "failure_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "repair_link_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "repair_link_digest": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "scope_digest": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "after_identity_digest": {
      "$ref": "common.schema.json#/$defs/sha256"
    }
  }
}
