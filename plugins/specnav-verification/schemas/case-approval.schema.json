{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specnav.dev/schemas/verification/v2/case-approval.schema.json",
  "title": "SpecNav Verification 2.0 Case Approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "change_id",
    "snapshot_id",
    "snapshot_hash",
    "decision",
    "reviewer",
    "decided_at"
  ],
  "properties": {
    "schema": {
      "const": "specnav.verification.case-approval.v1"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "change_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "snapshot_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "snapshot_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "decision": {
      "enum": [
        "approved",
        "rejected"
      ]
    },
    "reviewer": {
      "$ref": "common.schema.json#/$defs/reviewer"
    },
    "decided_at": {
      "$ref": "common.schema.json#/$defs/dateTime"
    },
    "comment": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    }
  }
}
