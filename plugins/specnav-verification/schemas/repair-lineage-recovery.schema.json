{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specnav.dev/schemas/verification/v2/repair-lineage-recovery.schema.json",
  "title": "SpecNav Verification 2.0 Repair Lineage Recovery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "failure_id",
    "change_id",
    "classification",
    "decision",
    "reviewer",
    "reviewed_at",
    "reason",
    "requested_envelope_digest",
    "invalid_envelopes",
    "repair_revision_range",
    "allowed_identity_drift",
    "expected_current_identity_digest",
    "recovered_repair_link",
    "verified_changes"
  ],
  "properties": {
    "schema": {
      "const": "specnav.verification.repair-lineage-recovery.v1"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "failure_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "change_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "classification": {
      "enum": [
        "product_defect",
        "test_defect"
      ]
    },
    "decision": {
      "const": "approved"
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/stableId"
        },
        "kind": {
          "const": "human"
        }
      }
    },
    "reviewed_at": {
      "$ref": "common.schema.json#/$defs/dateTime"
    },
    "reason": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "requested_envelope_digest": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "invalid_envelopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact",
          "envelope_digest",
          "drift_fields"
        ],
        "properties": {
          "artifact": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          },
          "envelope_digest": {
            "$ref": "common.schema.json#/$defs/sha256"
          },
          "drift_fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "common.schema.json#/$defs/nonEmptyString"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "repair_revision_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before_revision",
        "after_revision"
      ],
      "properties": {
        "before_revision": {
          "$ref": "common.schema.json#/$defs/sourceSha"
        },
        "after_revision": {
          "$ref": "common.schema.json#/$defs/sourceSha"
        }
      }
    },
    "allowed_identity_drift": {
      "type": "array",
      "items": {
        "enum": [
          "case_snapshot_hash",
          "environment_hash",
          "runtime_version",
          "kernel_version"
        ]
      },
      "uniqueItems": true
    },
    "expected_current_identity_digest": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "recovered_repair_link": {
      "$ref": "repair-link.schema.json"
    },
    "verified_changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "file"
        ],
        "properties": {
          "status": {
            "enum": [
              "A",
              "M",
              "D"
            ]
          },
          "file": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          }
        }
      }
    }
  }
}
