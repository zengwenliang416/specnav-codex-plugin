{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specnav.dev/schemas/verification/v2/host-install-receipt.schema.json",
  "title": "SpecNav Verification 2.0 Host Installation Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "host",
    "change_id",
    "release_gate_id",
    "archive_gate_id",
    "gate_input_sha256",
    "evidence_index_digest",
    "host_lock_sha256",
    "runtime_authority_digest",
    "runner_identity_sha256",
    "runner_source_sha256",
    "source_snapshot_digest",
    "fixture_snapshot_digest",
    "fixture_manifest_sha256",
    "repository",
    "ref",
    "commit",
    "remote_commit_reachable",
    "checkout_realpath",
    "plugin_realpath",
    "clean_checkout",
    "plugin_discovered",
    "runtime_ready",
    "checks",
    "execution",
    "execution_envelope_path",
    "execution_envelope_sha256",
    "attestation",
    "fallback_used",
    "recorded_at"
  ],
  "properties": {
    "schema": {
      "const": "specnav.verification.host-install-receipt.v1"
    },
    "host": {
      "enum": [
        "claude-code",
        "codex",
        "codefree-o",
        "dsh"
      ]
    },
    "change_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "release_gate_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "archive_gate_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "gate_input_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "evidence_index_digest": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "host_lock_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "runtime_authority_digest": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "runner_identity_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "runner_source_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "source_snapshot_digest": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "fixture_snapshot_digest": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "fixture_manifest_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "repository": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?:\\.git)?$"
    },
    "ref": {
      "type": "string",
      "pattern": "^refs/(?:heads|tags)/[A-Za-z0-9._/-]+$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "remote_commit_reachable": {
      "const": true
    },
    "checkout_realpath": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "plugin_realpath": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "clean_checkout": {
      "const": true
    },
    "plugin_discovered": {
      "const": true
    },
    "runtime_ready": {
      "const": true
    },
    "checks": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": {
                "const": "plugin-discovery"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": {
                "const": "remote-commit-reachability"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": {
                "const": "runtime-doctor"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": {
                "const": "host-smoke"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "evidence"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/stableId"
          },
          "status": {
            "const": "pass"
          },
          "evidence": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commands",
        "environment_sha256",
        "started_at",
        "completed_at"
      ],
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "argv",
              "exit_status",
              "stdout_sha256",
              "stderr_sha256",
              "stdout_path",
              "stderr_path"
            ],
            "properties": {
              "argv": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "common.schema.json#/$defs/nonEmptyString"
                }
              },
              "exit_status": {
                "const": 0
              },
              "stdout_sha256": {
                "$ref": "common.schema.json#/$defs/sha256"
              },
              "stderr_sha256": {
                "$ref": "common.schema.json#/$defs/sha256"
              },
              "stdout_path": {
                "$ref": "common.schema.json#/$defs/relativePath"
              },
              "stderr_path": {
                "$ref": "common.schema.json#/$defs/relativePath"
              }
            }
          }
        },
        "environment_sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "started_at": {
          "$ref": "common.schema.json#/$defs/dateTime"
        },
        "completed_at": {
          "$ref": "common.schema.json#/$defs/dateTime"
        }
      }
    },
    "execution_envelope_path": {
      "$ref": "common.schema.json#/$defs/relativePath"
    },
    "execution_envelope_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "attestation": {
      "const": "system-executed"
    },
    "fallback_used": {
      "const": false
    },
    "recorded_at": {
      "$ref": "common.schema.json#/$defs/dateTime"
    }
  }
}
